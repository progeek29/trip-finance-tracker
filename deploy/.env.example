# Copy to .env and fill in (NEVER commit .env)
# Public domain pointing at the VM (DuckDNS subdomain works free)
DOMAIN=wandersync-app.duckdns.org
# Strong random password for the in-VM Postgres (generate: openssl rand -hex 24)
POSTGRES_PASSWORD=change-me-to-something-long-and-random
# Closed-app voice FCM (optional — without it, socket live path still works).
# EITHER paste the Firebase service-account JSON inline:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# OR put the JSON in a file on the VM and point here (recommended).
# NOTE: path must be the CONTAINER path (/secrets/..., mounted read-only
# from /home/opc/secrets via docker-compose.yml), not the host path:
# FIREBASE_SERVICE_ACCOUNT_FILE=/secrets/firebase-service-account.json
# Google sign-on (public OAuth Web Client ID — same value as the frontend
# VITE_GOOGLE_CLIENT_ID; no secret, safe to share):
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
